# Only the two reviewed projects and repository metadata are in upload scope.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/SAQ-Reproduction/
!/QR-SVD/

# Generated/local files inside included projects.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/
.env
.env.*
!.env.example
*.pid
events.out.tfevents.*
.DS_Store
Thumbs.db

# Formal experiment logs belong to the published research record.
!/SAQ-Reproduction/records/**/*.log
!/QR-SVD/cifar100/records/**/*.log
